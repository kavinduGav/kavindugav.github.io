---
import { siteConfig, navLinks } from "../lib/config";
import ThemeToggle from "./ThemeToggle.astro";
import SoundToggle from "./SoundToggle.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === "/") return currentPath === "/" || currentPath.startsWith("/work/");
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<button
  id="mobile-menu-open"
  type="button"
  aria-haspopup="dialog"
  aria-controls="mobile-menu"
  aria-label="Open menu"
  class="grid size-11 shrink-0 place-items-center rounded-pill border border-border-strong text-text md:hidden"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5">
    <path d="M4 7h16M4 12h16M4 17h16" />
  </svg>
</button>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Site menu">
  <div class="flex h-full flex-col gap-10 overflow-y-auto px-6 py-6">
    <div class="flex items-center justify-between">
      <span class="font-heading text-lg font-bold uppercase tracking-tight text-text">
        {siteConfig.initials}<span class="text-accent-text">.</span>
      </span>
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Close menu"
        class="grid size-11 place-items-center rounded-pill border border-border-strong text-text"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <nav class="flex flex-col gap-2 text-2xl font-heading font-semibold uppercase tracking-tight">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-2xl px-4 py-4",
            link.accent
              ? "bg-accent text-on-accent"
              : isActive(link.href)
                ? "bg-surface-2 text-text"
                : "text-text-2",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="mt-auto flex items-center gap-3 border-t border-divider pt-6 font-mono text-xs uppercase tracking-wide text-subtle">
      <span class="mr-auto">Theme &amp; sound</span>
      <ThemeToggle />
      <SoundToggle />
    </div>
  </div>
</dialog>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    border: none;
    padding: 0;
    background: var(--bg);
    color: var(--text);
  }
  .mobile-menu[open] {
    display: flex;
  }
  .mobile-menu::backdrop {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
</style>

<script>
  function initMobileMenu() {
    const dialog = document.getElementById("mobile-menu") as HTMLDialogElement | null;
    const openBtn = document.getElementById("mobile-menu-open");
    const closeBtn = document.getElementById("mobile-menu-close");
    if (!dialog || !openBtn || !closeBtn || dialog.dataset.bound) return;
    dialog.dataset.bound = "true";

    openBtn.addEventListener("click", () => {
      dialog.showModal();
      document.body.style.overflow = "hidden";
    });

    const close = () => {
      dialog.close();
    };
    closeBtn.addEventListener("click", close);

    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });

    // Close when a nav link inside is activated (before navigation swaps the page).
    dialog.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));

    // Clicking the backdrop (outside the content column) closes it.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
  }

  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
