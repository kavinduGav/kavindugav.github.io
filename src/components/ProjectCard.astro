---
import MediaPlaceholder from "./MediaPlaceholder.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  tag: string;
  media: string;
  /** Project slug — used to morph this card's media into the matching hero on its /work/[slug] page. */
  transitionId?: string;
}

const { href, title, description, tag, media, transitionId } = Astro.props;
---

<a
  href={href}
  class="group relative flex h-full flex-col gap-3.5 rounded-card border border-border bg-surface p-3.5 transition-[border-color,transform,box-shadow,opacity,filter] duration-200 ease-out hover:-translate-y-[3px] hover:border-accent hover:shadow-[0_16px_40px_-20px_var(--accent)] active:translate-y-0 active:scale-[0.99]"
>
  <MediaPlaceholder
    aspect="16/10"
    caption={media}
    class="flex-1"
    transitionName={transitionId ? `project-media-${transitionId}` : undefined}
  />
  <div class="flex items-start justify-between gap-3 px-1.5 pb-1.5">
    <div>
      <div class="text-[19px] font-bold text-text">{title}</div>
      <div class="mt-0.5 text-sm text-subtle">{description}</div>
    </div>
    <span class="flex-none rounded-pill border border-accent-text px-2.5 py-[5px] text-xs text-accent-text">{tag}</span>
  </div>
</a>
