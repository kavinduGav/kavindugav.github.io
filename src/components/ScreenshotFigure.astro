---
import MediaPlaceholder from "./MediaPlaceholder.astro";

interface Props {
  media: string;
  caption: string;
  wide?: boolean;
}

const { media, caption, wide = false } = Astro.props;
---

<figure class:list={["reveal-item flex flex-col gap-3 rounded-card border border-border bg-surface p-3.5", wide && "sm:col-span-full"]}>
  <MediaPlaceholder aspect={wide ? "16/6" : "16/10"} caption={media} />
  <figcaption class="px-1.5 pb-1.5 text-sm text-subtle">{caption}</figcaption>
</figure>
