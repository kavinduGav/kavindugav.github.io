---
---

<button
  id="sound-toggle"
  type="button"
  aria-label="Toggle sound"
  aria-pressed="false"
  class="sound-toggle grid size-10 shrink-0 place-items-center rounded-pill border border-border-strong text-text transition-colors hover:border-accent"
>
  <span class="eq" aria-hidden="true">
    <span></span><span></span><span></span>
  </span>
</button>

<style>
  .eq {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 14px;
  }
  .eq span {
    width: 3px;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.55;
    height: 5px;
  }
  .sound-toggle.is-on .eq span {
    opacity: 1;
    animation: eq-bounce 0.9s ease-in-out infinite;
  }
  .sound-toggle.is-on .eq span:nth-child(1) {
    animation-delay: -0.6s;
  }
  .sound-toggle.is-on .eq span:nth-child(2) {
    animation-delay: -0.3s;
  }
  .sound-toggle.is-on .eq span:nth-child(3) {
    animation-delay: 0s;
  }
  @keyframes eq-bounce {
    0%,
    100% {
      height: 4px;
    }
    50% {
      height: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sound-toggle.is-on .eq span {
      animation: none;
      height: 10px;
    }
  }
</style>

<script>
  function syncButton() {
    const btn = document.getElementById("sound-toggle");
    if (!btn) return;
    let enabled = false;
    try {
      enabled = localStorage.getItem("sound") === "on";
    } catch {
      /* ignore */
    }
    btn.classList.toggle("is-on", enabled);
    btn.setAttribute("aria-pressed", String(enabled));
  }

  function initSoundToggle() {
    const btn = document.getElementById("sound-toggle");
    if (!btn || btn.dataset.bound) {
      syncButton();
      return;
    }
    btn.dataset.bound = "true";
    btn.addEventListener("click", () => {
      let enabled = false;
      try {
        enabled = localStorage.getItem("sound") === "on";
        localStorage.setItem("sound", enabled ? "off" : "on");
      } catch {
        /* ignore */
      }
      syncButton();
      document.dispatchEvent(new CustomEvent("soundpref:change", { detail: { enabled: !enabled } }));
    });
    syncButton();
  }

  initSoundToggle();
  document.addEventListener("astro:page-load", initSoundToggle);
</script>
