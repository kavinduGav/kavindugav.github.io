---
interface Props {
  value: string;
  label: string;
  accent?: boolean;
}

const { value, label, accent = false } = Astro.props;

// Tiles with a leading number ("3,000+", "10+") count up from 0 on scroll
// into view; non-numeric ones ("IJACSA", "Next.js") just render as-is.
const match = value.match(/^([\d,]+)(.*)$/);
const countTo = match ? Number(match[1].replace(/,/g, "")) : undefined;
const countSuffix = match ? match[2] : undefined;
---

<div
  class:list={[
    "stat-tile flex flex-col gap-1.5 rounded-card border p-5",
    accent ? "border-transparent bg-accent text-on-accent" : "border-border bg-surface",
  ]}
>
  <span class="stat-value font-heading text-[28px] font-bold" data-count-to={countTo} data-count-suffix={countSuffix}>{value}</span>
  <span class:list={["text-sm", accent ? "font-bold" : "text-subtle"]}>{label}</span>
</div>
