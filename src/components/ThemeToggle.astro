---
---

<button
  type="button"
  aria-label="Toggle color theme"
  aria-pressed="false"
  class="theme-toggle relative grid size-10 shrink-0 place-items-center rounded-pill border border-border-strong text-text transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent active:translate-y-0 active:scale-90"
>
  <svg class="sun-icon absolute size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="moon-icon absolute size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
  </svg>
</button>

<style>
  .sun-icon,
  .moon-icon {
    transition:
      opacity 0.35s ease,
      transform 0.45s ease;
  }
  .moon-icon {
    opacity: 0;
    transform: rotate(-80deg) scale(0.4);
  }
  .sun-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  .theme-toggle.is-light .sun-icon {
    opacity: 0;
    transform: rotate(80deg) scale(0.4);
  }
  .theme-toggle.is-light .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<script>
  function resolvedTheme(): "light" | "dark" {
    const stored = document.documentElement.dataset.theme;
    if (stored === "light" || stored === "dark") return stored;
    return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  }

  function syncButtons() {
    const isLight = resolvedTheme() === "light";
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((btn) => {
      btn.classList.toggle("is-light", isLight);
      btn.setAttribute("aria-pressed", String(isLight));
    });
  }

  /**
   * Elements with their own transition:name (nav's active-pill/logo,
   * project-card media) get independent view-transition groups that render
   * in the browser's top layer, floating above everything — including the
   * nav — regardless of z-index. That's only meant for page navigations;
   * strip it for the theme toggle's own unrelated circular-reveal
   * transition so only ::view-transition-*(root) animates, then restore it.
   */
  function suppressNamedTransitions(): () => void {
    // Astro applies transition:name via a generated stylesheet rule keyed
    // off this data attribute, not an inline style — so override it with an
    // actual inline style, which wins over that rule without !important.
    const named = Array.from(document.querySelectorAll<HTMLElement>("[data-astro-transition-scope]"));
    named.forEach((el) => {
      el.style.setProperty("view-transition-name", "none");
    });
    return () => {
      named.forEach((el) => {
        el.style.removeProperty("view-transition-name");
      });
    };
  }

  function applyTheme(next: "light" | "dark", origin?: { x: number; y: number }) {
    const root = document.documentElement;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const commit = () => {
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* storage unavailable (private mode, etc.) — theme just won't persist */
      }
      syncButtons();
    };

    if (reduceMotion || !document.startViewTransition || !origin) {
      commit();
      return;
    }

    const endRadius = Math.hypot(
      Math.max(origin.x, window.innerWidth - origin.x),
      Math.max(origin.y, window.innerHeight - origin.y),
    );

    const restoreNamedTransitions = suppressNamedTransitions();
    const transition = document.startViewTransition(commit);
    transition.ready
      .then(() =>
        document.documentElement.animate(
          {
            clipPath: [`circle(0px at ${origin.x}px ${origin.y}px)`, `circle(${endRadius}px at ${origin.x}px ${origin.y}px)`],
          },
          { duration: 380, easing: "ease-in-out", pseudoElement: "::view-transition-new(root)" },
        ),
      )
      .catch(() => {});
    transition.finished.finally(restoreNamedTransitions).catch(() => {});
  }

  function initThemeToggles() {
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const next = resolvedTheme() === "light" ? "dark" : "light";
        const rect = btn.getBoundingClientRect();
        applyTheme(next, { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 });
      });
    });
    syncButtons();
  }

  document.addEventListener("astro:page-load", initThemeToggles);

  // astro:before-swap (not before-preparation) — Astro's swap reconciles
  // <html>'s attributes to match the incoming document, and the fetched
  // document's raw <html> tag never carries data-theme (it's only ever set
  // client-side), so without this the theme gets wiped on every navigation.
  // Setting it on event.newDocument here means it's already correct once
  // that document becomes live.
  document.addEventListener("astro:before-swap", (event) => {
    const e = event as unknown as { newDocument: Document };
    const theme = document.documentElement.dataset.theme;
    if (theme === "light" || theme === "dark") {
      e.newDocument.documentElement.dataset.theme = theme;
    }
  });
</script>
