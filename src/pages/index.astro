---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import StatTile from "../components/StatTile.astro";
import ProjectCard from "../components/ProjectCard.astro";
import DownloadCvButton from "../components/DownloadCvButton.astro";
import { siteConfig } from "../lib/config";
import { getOrderedProjects, projectHref } from "../lib/projects";

const projects = await getOrderedProjects();
const filters = ["All", "Web", "Mobile", "Research"] as const;

const stats = [
  { value: "3,000+", label: "daily users on my apps" },
  { value: "IJACSA", label: "Accepted · IJACSA 2026" },
  { value: "Next.js", label: "+ React · Node · TypeScript" },
  { value: siteConfig.stats.enterpriseSystems, label: "enterprise systems shipped", accent: true },
];

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: siteConfig.url,
  email: `mailto:${siteConfig.email}`,
  jobTitle: "Associate Software Engineer",
  worksFor: { "@type": "Organization", name: "OREL Group" },
  address: { "@type": "PostalAddress", addressLocality: siteConfig.location },
  sameAs: [siteConfig.social.github, siteConfig.social.linkedin],
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <header class="mx-auto grid max-w-[1280px] grid-cols-1 gap-10 px-5 py-10 sm:px-10 min-[900px]:grid-cols-2 min-[900px]:items-center min-[900px]:py-9">
    <div class="flex flex-col gap-6">
      <div class="flex items-center gap-2.5 font-mono text-[13px] tracking-wide text-subtle">
        <span class="size-2 rounded-full bg-accent"></span>
        OPEN TO WORK · {siteConfig.location}
      </div>
      <h1
        data-hero-heading
        class="font-heading text-[clamp(38px,5vw,60px)] font-extrabold uppercase leading-none tracking-[-0.03em]"
      >
        Backend, web &amp; mobile systems that <span class="text-accent-text">ship</span>.
      </h1>
      <p class="max-w-[500px] text-lg leading-[1.55] text-muted">
        Associate Software Engineer at OREL Group. Node.js, TypeScript and Flutter, from enterprise back-office to apps used by 3,000+ people daily.
      </p>
      <div class="flex flex-wrap gap-2.5">
        <a href="#work" class="magnetic rounded-pill bg-accent px-[22px] py-3.5 font-bold text-on-accent transition-[filter] duration-200 ease-out hover:brightness-110">
          View projects
        </a>
        <DownloadCvButton />
      </div>
    </div>
    <div class="rounded-[18px] border border-border bg-surface p-3.5">
      <MediaPlaceholder aspect="16/10" icon="play" caption="showreel.mp4: 30s muted loop" />
    </div>
  </header>

  <div id="stats-grid" class="mx-auto grid max-w-[1280px] grid-cols-2 gap-3 px-5 pb-12 sm:px-10 lg:grid-cols-4">
    {stats.map((stat) => <StatTile value={stat.value} label={stat.label} accent={stat.accent} />)}
  </div>

  <section id="work" class="mx-auto flex max-w-[1280px] scroll-mt-[104px] flex-col gap-5 px-5 pb-20 sm:px-10">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-heading text-[28px] font-bold">Selected work</h2>
      <div id="work-filters" class="flex flex-wrap gap-2 text-sm">
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f}
            aria-pressed={i === 0 ? "true" : "false"}
            class:list={[
              "filter-chip rounded-pill border border-border-strong px-3.5 py-[7px] font-bold transition-[background-color,color,transform] duration-150 hover:-translate-y-0.5 active:translate-y-0 active:scale-95",
              i === 0 ? "bg-text text-bg" : "bg-transparent text-text-2",
            ]}
          >
            {f}
          </button>
        ))}
      </div>
    </div>
    <div id="work-grid" class="bento grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {projects.map((project) => (
        <div data-category={project.data.category} data-slug={project.id} class="work-item flex h-full flex-col">
          <ProjectCard
            href={projectHref(project)}
            title={project.data.title}
            description={project.data.description}
            tag={project.data.tag}
            media={project.data.homeMedia}
            transitionId={project.id}
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .filter-chip[aria-pressed="true"] {
    background-color: var(--text);
    color: var(--bg);
  }
  .filter-chip[aria-pressed="false"] {
    background-color: transparent;
    color: var(--text-2);
  }
  .work-item[hidden] {
    display: none;
  }

  /* Bento mosaic: only while "All" is selected (see the filter script) and
     only once there's room for it at the xl 3-column breakpoint. */
  @media (min-width: 1280px) {
    #work-grid.bento {
      grid-auto-flow: dense;
    }
    #work-grid.bento [data-slug="warehouse-management-system"] {
      grid-column: span 2;
    }
    #work-grid.bento [data-slug="orel-mobile-suite"] {
      grid-row: span 2;
    }
    #work-grid.bento [data-slug="canine-biometric-id"] {
      grid-column: span 2;
    }
  }

  .work-item {
    transition:
      opacity 0.3s ease,
      filter 0.3s ease;
  }
  #work-grid.bento:has(.work-item:hover) .work-item:not(:hover) {
    opacity: 0.55;
    filter: saturate(0.5);
  }
</style>

<script>
  import {
    ensureGsapRegistered,
    ScrollTrigger,
    prefersReducedMotion,
    revealHeroHeading,
    revealOnScroll,
    popInEach,
    animateCounters,
    initMagnetic,
    animateLayoutChange,
    cleanupScrollTriggers,
  } from "../lib/animations";

  function initWorkFilters() {
    const container = document.getElementById("work-filters");
    const grid = document.getElementById("work-grid");
    if (!container || !grid || container.dataset.bound) return;
    container.dataset.bound = "true";

    const chips = Array.from(container.querySelectorAll<HTMLButtonElement>("[data-filter]"));

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const filter = chip.dataset.filter;
        ensureGsapRegistered();
        animateLayoutChange(grid, () => {
          chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
          Array.from(grid.querySelectorAll<HTMLElement>(".work-item")).forEach((item) => {
            const show = filter === "All" || item.dataset.category === filter;
            item.toggleAttribute("hidden", !show);
          });
          // The mosaic spans only make sense when every card is showing.
          grid.classList.toggle("bento", filter === "All");
        });
        // Layout shifted (cards appeared/disappeared) — let ScrollTrigger recompute positions.
        requestAnimationFrame(() => ScrollTrigger.refresh());
      });
    });
  }

  function initHomeAnimations() {
    ensureGsapRegistered();
    initMagnetic(".magnetic");
    if (prefersReducedMotion()) return;

    revealHeroHeading(document.querySelector<HTMLElement>("[data-hero-heading]"));

    const statTiles = document.querySelectorAll(".stat-tile");
    const workItems = document.querySelectorAll(".work-item");
    if (statTiles.length) {
      revealOnScroll(statTiles, { y: 20, stagger: 0.08 });
      animateCounters(document.querySelectorAll(".stat-value"));
    }
    if (workItems.length) popInEach(workItems);
  }

  function initHome() {
    initWorkFilters();
    initHomeAnimations();
  }

  document.addEventListener("astro:before-swap", cleanupScrollTriggers);
  document.addEventListener("astro:page-load", initHome);
</script>
